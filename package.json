{
  "name": "harvest-valley",
  "private": true,
  "version": "0.1.0",
  "description": "Harvest Valley - Farm game (Telegram Mini App). Canvas 2D renderer base.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "assets:generate": "node scripts/generate-dev-assets.mjs",
    "api:dev": "wrangler dev",
    "api:typecheck": "tsc -p worker/tsconfig.json",
    "api:migrate": "wrangler d1 migrations apply harvest-valley-db --local",
    "api:test": "node scripts/test-admin.mjs"
  },
  "dependencies": {
    "hono": "^4.13.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "wrangler": "^4.125.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260820.1": true
  }
}
